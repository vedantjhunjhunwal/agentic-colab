# Agentic AI DSL Colab — Supabase-only authentication

# Required for login/register
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key

# Required for stable Flask sessions on Render
COLAB_SECRET=change-me-to-a-long-random-secret

# Optional: persistent Postgres database for notebooks/users
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: app storage directory
# COLAB_DATA_DIR=/opt/render/project/src/data

# Optional: external API keys used by notebook/runtime features
# OPENAI_API_KEY=
# KAGGLE_USERNAME=
# KAGGLE_KEY=
