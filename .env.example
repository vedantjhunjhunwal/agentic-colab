# ===========================================================================
#  Copy this file to ".env"  (exact name, no .txt extension) and fill in values
#  On Windows, make sure it is saved as ".env" not ".env.txt"
# ===========================================================================

# ── Gmail SMTP — required for OTP email (registration, 2FA, password reset) ──
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password below (spaces are fine, they're stripped).
#    Do NOT use your normal Gmail password — it will be rejected.
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your16charapppassword

# Optional SMTP overrides (defaults shown — work for Gmail as-is)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# MAIL_DEFAULT_SENDER=youraddress@gmail.com   # defaults to MAIL_USERNAME

# ── Auth ─────────────────────────────────────────────────────────────────
ENABLE_2FA=true            # set to false to skip the 2FA step at login (dev only)

# ── Google OAuth (optional — adds "Sign in with Google") ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=http://192.168.29.141:5001   # set for LAN/proxy hosting

# ── Persistence / server ────────────────────────────────────────────────────
COLAB_SECRET=              # auto-generated if blank (set one for stable sessions)
COLAB_DATA_DIR=./data
PORT=8080

# ── LLM for AIDL generate()/agent() and the assistant (optional) ───────────
AGENT_LLM_PROVIDER=        # openai | gemini
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Kaggle dataset import (optional) ─────────────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=
