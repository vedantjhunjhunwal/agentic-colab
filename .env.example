# ===========================================================================
#  Copy this file to ".env" (exact name, no .txt) and fill in values.
# ===========================================================================

# ── Email for OTP (registration / 2FA / password reset) ────────────────────
# Choose ONE backend.
#
# OPTION A — Brevo HTTP API (REQUIRED on Render & most cloud hosts, which
#            block SMTP). Free 300 emails/day at https://www.brevo.com
#   1. Verify a sender email in Brevo (Settings → Senders).
#   2. Create an API key (Settings → SMTP & API → API Keys).
BREVO_API_KEY=
MAIL_FROM=your_verified_sender@example.com
MAIL_FROM_NAME=Agentic AI DSL Colab
#   (SendGrid or Resend also work — set SENDGRID_API_KEY or RESEND_API_KEY
#    instead of BREVO_API_KEY, plus MAIL_FROM.)
# SENDGRID_API_KEY=
# RESEND_API_KEY=
#
# OPTION B — Gmail SMTP (works LOCALLY or on a VM/EC2, NOT on Render).
#   Use a Gmail App Password (https://myaccount.google.com/apppasswords),
#   not your normal password.
# MAIL_USERNAME=youraddress@gmail.com
# MAIL_PASSWORD=your16charapppassword
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true

# ── Auth ────────────────────────────────────────────────────────────────────
ENABLE_2FA=true

# ── Supabase Auth (optional — replaces app OTP email when configured) ───────
# Create a Supabase project → Project Settings → API. Copy these values.
# When both are set, the existing email/password login and registration forms
# use Supabase Auth over HTTPS, so Render SMTP/Resend OTP is not required.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Set to a Postgres URL (Neon/Render/Supabase) to persist users + notebooks.
# Leave blank for local dev (uses a SQLite file in ./data automatically).
DATABASE_URL=

# ── Google OAuth (optional — adds "Sign in with Google") ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=https://your-app.onrender.com

# ── Server / persistence ──────────────────────────────────────────────────
COLAB_SECRET=
COLAB_DATA_DIR=./data
PORT=8080

# ── LLM for AIDL generate()/agent() and assistant (optional) ───────────────
AGENT_LLM_PROVIDER=
OPENAI_API_KEY=
GOOGLE_API_KEY=
